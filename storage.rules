rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    match /users/{uid}/profile/{file} { allow read: if signedIn(); allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024; }
    match /classes/{classId}/materials/{file} { allow read: if signedIn(); allow write: if signedIn() && request.resource.size < 25 * 1024 * 1024; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
